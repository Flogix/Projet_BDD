<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.project.artconnect.ui.WorkshopController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    <TableView fx:id="workshopTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="titleColumn" text="Title" prefWidth="200" />
            <TableColumn fx:id="instructorColumn" text="Instructor" prefWidth="150" />
            <TableColumn fx:id="dateColumn" text="Date" prefWidth="150" />
            <TableColumn fx:id="priceColumn" text="Price" prefWidth="80" />
        </columns>
    </TableView>

    <TitledPane text="Ajouter / Modifier un atelier" expanded="false">
        <VBox spacing="8.0">
            <padding><Insets bottom="8.0" left="8.0" right="8.0" top="8.0"/></padding>
            <HBox spacing="10.0">
                <TextField fx:id="fieldTitle" promptText="Titre de l'atelier" HBox.hgrow="ALWAYS"/>
                <TextField fx:id="fieldInstructor" promptText="Nom de l'artiste" HBox.hgrow="ALWAYS"/>
                <DatePicker fx:id="fieldDate" promptText="Date" prefWidth="130"/>
                <TextField fx:id="fieldPrice" promptText="Prix" prefWidth="80"/>
            </HBox>
            <HBox spacing="10.0">
                <Button text="➕ Ajouter" onAction="#handleAdd" styleClass="button-add"/>
                <Button text="✏️ Modifier" onAction="#handleUpdate" styleClass="button-edit"/>
                <Button text="🗑️ Supprimer" onAction="#handleDelete" styleClass="button-delete"/>
                <Region HBox.hgrow="ALWAYS" />
                <Button text="💰 Calculer Revenu Max" onAction="#handleCalculateRevenue" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </HBox>
        </VBox>
    </TitledPane>
</VBox>
