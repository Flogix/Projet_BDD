<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.project.artconnect.ui.GalleryController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    
    <TableView fx:id="galleryTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="nameColumn" text="Name" prefWidth="250" />
            <TableColumn fx:id="addressColumn" text="Address" prefWidth="350" />
            <TableColumn fx:id="ratingColumn" text="Rating" prefWidth="100" />
        </columns>
    </TableView>
    
    <TitledPane text="Ajouter / Modifier une galerie" expanded="false">
        <VBox spacing="8.0">
            <padding><Insets bottom="8.0" left="8.0" right="8.0" top="8.0"/></padding>
            <HBox spacing="10.0">
                <TextField fx:id="fieldName" promptText="Nom de la galerie" HBox.hgrow="ALWAYS"/>
                <TextField fx:id="fieldAddress" promptText="Adresse" HBox.hgrow="ALWAYS"/>
                <TextField fx:id="fieldRating" promptText="Note (0-5)" prefWidth="100"/>
            </HBox>
            <HBox spacing="10.0">
                <Button text="➕ Ajouter" onAction="#handleAdd" styleClass="button-add"/>
                <Button text="✏️ Modifier" onAction="#handleUpdate" styleClass="button-edit"/>
                <Button text="🗑️ Supprimer" onAction="#handleDelete" styleClass="button-delete"/>
            </HBox>
        </VBox>
    </TitledPane>
</VBox>
