<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.project.artconnect.ui.DiscoverController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #2c3e50; -fx-padding: 15; -fx-background-radius: 5;">
        <Label text="🌟 Featured Exhibitions and Upcoming Workshops" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: white;"/>
    </HBox>
    <ScrollPane VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
        <FlowPane fx:id="discoverPane" hgap="20" vgap="20" prefWrapLength="1100" style="-fx-padding: 10;">
            <!-- Cards will be added programmatically -->
        </FlowPane>
    </ScrollPane>
</VBox>