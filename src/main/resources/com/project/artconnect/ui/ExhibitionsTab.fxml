<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.project.artconnect.ui.ExhibitionController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    
    <TableView fx:id="exhibitionTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="titleColumn" text="Title" prefWidth="200" />
            <TableColumn fx:id="galleryColumn" text="Gallery" prefWidth="150" />
            <TableColumn fx:id="dateColumn" text="Start Date" prefWidth="120" />
            <TableColumn fx:id="themeColumn" text="Theme" prefWidth="180" />
        </columns>
    </TableView>

    <TitledPane text="Ajouter / Modifier une exposition" expanded="false">
        <VBox spacing="8.0">
            <padding><Insets bottom="8.0" left="8.0" right="8.0" top="8.0"/></padding>
            <HBox spacing="10.0">
                <TextField fx:id="fieldTitle" promptText="Titre de l'exposition" HBox.hgrow="ALWAYS"/>
                <TextField fx:id="fieldGallery" promptText="Nom de la galerie" HBox.hgrow="ALWAYS"/>
                <DatePicker fx:id="fieldStartDate" promptText="Date de début" prefWidth="130"/>
                <TextField fx:id="fieldTheme" promptText="Thème" HBox.hgrow="ALWAYS"/>
            </HBox>
            <HBox spacing="10.0">
                <Button text="➕ Ajouter" onAction="#handleAdd" styleClass="button-add"/>
                <Button text="✏️ Modifier" onAction="#handleUpdate" styleClass="button-edit"/>
                <Button text="🗑️ Supprimer" onAction="#handleDelete" styleClass="button-delete"/>
            </HBox>
        </VBox>
    </TitledPane>
</VBox>
