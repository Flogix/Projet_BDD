<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.project.artconnect.ui.ArtistController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
    </padding>

    <!-- Barre de recherche -->
    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="Search artists..." HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="disciplineFilter" promptText="Filter by Discipline"/>
        <Button text="Search" onAction="#handleSearch"/>
        <Button text="Reset" onAction="#handleReset"/>
    </HBox>

    <!-- Tableau -->
    <TableView fx:id="artistTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="nameColumn" text="Name" prefWidth="200"/>
            <TableColumn fx:id="cityColumn" text="City" prefWidth="150"/>
            <TableColumn fx:id="emailColumn" text="Email" prefWidth="200"/>
            <TableColumn fx:id="yearColumn" text="Birth Year" prefWidth="100"/>
        </columns>
    </TableView>

    <!-- Formulaire d'ajout / modification -->
    <TitledPane text="Ajouter / Modifier un artiste" expanded="false">
        <VBox spacing="8.0">
            <padding><Insets bottom="8.0" left="8.0" right="8.0" top="8.0"/></padding>
            <HBox spacing="10.0">
                <TextField fx:id="fieldName"       promptText="Nom complet (ex: Moreau Claire)" HBox.hgrow="ALWAYS"/>
                <TextField fx:id="fieldEmail"      promptText="Email"                            HBox.hgrow="ALWAYS"/>
                <TextField fx:id="fieldCity"       promptText="Ville"                            HBox.hgrow="ALWAYS"/>
                <TextField fx:id="fieldYear"       promptText="Année naissance"                  prefWidth="140"/>
                <TextField fx:id="fieldDiscipline" promptText="Discipline"                       HBox.hgrow="ALWAYS"/>
            </HBox>
            <HBox spacing="10.0">
                <Button text="➕ Ajouter" onAction="#handleAdd" styleClass="button-add"/>
                <Button text="✏️ Modifier" onAction="#handleUpdate" styleClass="button-edit"/>
                <Button text="🗑️ Supprimer" onAction="#handleDelete" styleClass="button-delete"/>
            </HBox>
        </VBox>
    </TitledPane>
</VBox>
