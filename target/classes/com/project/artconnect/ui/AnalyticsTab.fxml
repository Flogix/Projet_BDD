<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.project.artconnect.ui.AnalyticsController"
      style="-fx-background-color: #f5f5f5;">
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
    </padding>

    <!-- Titre -->
    <Label text="📊 Analytics — Statistiques de la base" style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

    <!-- Ligne 1 : 5 cartes KPI -->
    <HBox spacing="15.0">
        <!-- Carte : Artistes -->
        <VBox fx:id="cardArtists" spacing="5.0" alignment="CENTER" prefWidth="200" prefHeight="100"
              style="-fx-background-color: #3498db; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.15),8,0,0,2);">
            <Label fx:id="labelNbArtists" text="—" style="-fx-font-size: 36; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Artistes" style="-fx-font-size: 13; -fx-text-fill: white;"/>
        </VBox>

        <!-- Carte : Œuvres -->
        <VBox fx:id="cardArtworks" spacing="5.0" alignment="CENTER" prefWidth="200" prefHeight="100"
              style="-fx-background-color: #9b59b6; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.15),8,0,0,2);">
            <Label fx:id="labelNbArtworks" text="—" style="-fx-font-size: 36; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Œuvres" style="-fx-font-size: 13; -fx-text-fill: white;"/>
        </VBox>

        <!-- Carte : Prix moyen -->
        <VBox fx:id="cardAvgPrice" spacing="5.0" alignment="CENTER" prefWidth="200" prefHeight="100"
              style="-fx-background-color: #e67e22; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.15),8,0,0,2);">
            <Label fx:id="labelAvgPrice" text="—" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Prix moyen" style="-fx-font-size: 13; -fx-text-fill: white;"/>
        </VBox>

        <!-- Carte : Ventes Totales -->
        <VBox fx:id="cardTotalSales" spacing="5.0" alignment="CENTER" prefWidth="200" prefHeight="100"
              style="-fx-background-color: #27ae60; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.15),8,0,0,2);">
            <Label fx:id="labelTotalSales" text="—" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Ventes Totales" style="-fx-font-size: 13; -fx-text-fill: white;"/>
        </VBox>

        <!-- Carte : Œuvre la plus chère -->
        <VBox fx:id="cardMostExpensive" spacing="5.0" alignment="CENTER" prefWidth="280" prefHeight="100"
              style="-fx-background-color: #e74c3c; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.15),8,0,0,2);">
            <Label fx:id="labelMostExpensive" text="—" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: white; -fx-wrap-text: true;" maxWidth="260"/>
            <Label text="Œuvre la plus chère" style="-fx-font-size: 13; -fx-text-fill: white;"/>
        </VBox>
    </HBox>

    <!-- Ligne 2 : deux tableaux côte à côte -->
    <HBox spacing="15.0" VBox.vgrow="ALWAYS">

        <!-- Artistes par ville -->
        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
            <Label text="🏙️ Artistes par ville" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <TableView fx:id="cityTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="cityNameCol" text="Ville" prefWidth="160"/>
                    <TableColumn fx:id="cityCountCol" text="Nombre d'artistes" prefWidth="140"/>
                </columns>
            </TableView>
        </VBox>

        <!-- Top artistes (par nb d'œuvres) -->
        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
            <Label text="🏆 Top artistes (par œuvres)" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <TableView fx:id="topArtistTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="topArtistNameCol" text="Artiste" prefWidth="180"/>
                    <TableColumn fx:id="topArtistCountCol" text="Nb œuvres" prefWidth="100"/>
                    <TableColumn fx:id="topArtistValueCol" text="Valeur portfolio" prefWidth="130"/>
                </columns>
            </TableView>
        </VBox>

        <!-- Galerie la mieux notée -->
        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
            <Label text="⭐ Galeries (par note)" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <TableView fx:id="galleryRankTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="galleryNameCol" text="Galerie" prefWidth="180"/>
                    <TableColumn fx:id="galleryNoteCol" text="Note" prefWidth="60"/>
                    <TableColumn fx:id="galleryExpoCol" text="Expositions" prefWidth="100"/>
                </columns>
            </TableView>
        </VBox>

        <!-- Evénements à venir -->
        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
            <Label text="📅 Evénements à venir" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <TableView fx:id="eventsTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="eventTypeCol" text="Type" prefWidth="100"/>
                    <TableColumn fx:id="eventTitleCol" text="Titre" prefWidth="150"/>
                    <TableColumn fx:id="eventDateCol" text="Date" prefWidth="90"/>
                </columns>
            </TableView>
        </VBox>

    </HBox>
</VBox>
