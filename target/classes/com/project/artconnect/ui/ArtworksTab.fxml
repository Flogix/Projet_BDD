<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.project.artconnect.ui.ArtworkController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
    </padding>

    <!-- Tableau -->
    <TableView fx:id="artworkTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="titleColumn"  text="Title"  prefWidth="200"/>
            <TableColumn fx:id="artistColumn" text="Artist" prefWidth="150"/>
            <TableColumn fx:id="typeColumn"   text="Type"   prefWidth="100"/>
            <TableColumn fx:id="priceColumn"  text="Price"  prefWidth="100"/>
            <TableColumn fx:id="statusColumn" text="Status" prefWidth="150"/>
        </columns>
    </TableView>

    <!-- Formulaire CRUD -->
    <TitledPane text="Ajouter / Modifier une œuvre" expanded="false">
        <VBox spacing="8.0">
            <padding><Insets bottom="8.0" left="8.0" right="8.0" top="8.0"/></padding>
            <HBox spacing="10.0">
                <TextField fx:id="fieldTitle"      promptText="Titre"                     HBox.hgrow="ALWAYS"/>
                <TextField fx:id="fieldArtistName" promptText="Nom artiste (ex: Moreau Claire)" HBox.hgrow="ALWAYS"/>
                <TextField fx:id="fieldType"       promptText="Type (Peinture, Sculpture…)" HBox.hgrow="ALWAYS"/>
                <TextField fx:id="fieldPrice"      promptText="Prix"                      prefWidth="120"/>
                <ComboBox  fx:id="fieldStatus"     promptText="Statut"                    prefWidth="130"/>
            </HBox>
            <HBox spacing="10.0">
                <Button text="➕ Ajouter" onAction="#handleAdd" styleClass="button-add"/>
                <Button text="✏️ Modifier" onAction="#handleUpdate" styleClass="button-edit"/>
                <Button text="🗑️ Supprimer" onAction="#handleDelete" styleClass="button-delete"/>
            </HBox>
        </VBox>
    </TitledPane>
</VBox>
